# ══════════════════════════════════════════════════════════════════
#  Money Matters AI — Frontend Environment Variables
#  Copy this file to .env.local for local development.
#  For Vercel/Netlify: set these in the platform's env vars UI.
# ══════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend API (Stock Analysis + Expense Classifier) ─────────────
# Local dev:    http://localhost:8001
# Render prod:  https://your-render-service.onrender.com
VITE_STOCK_API_URL=http://localhost:8001

# ── LLM API (Finance Advisor — Modal.com or same Render backend) ──
# If using Modal.com serverless:  https://your-workspace--finance-llama-api-...modal.run
# If using same Render backend:   https://your-render-service.onrender.com/get-advice
VITE_API_URL=http://localhost:8001

# ── EmailJS (Contact Form) ───────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

